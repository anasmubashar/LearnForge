# Get your free Gemini API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Qdrant Cloud connection (https://cloud.qdrant.io — free tier available)
QDRANT_URL=https://your-cluster-id.us-east-2-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# --- OR for local/offline mode, leave QDRANT_URL empty and set: ---
# QDRANT_PATH=./qdrant_db

# Knowledge base path (relative to backend/)
KB_PATH=./learnforge-knowledge-base

# Confidence threshold below which we escalate to human (0.0 - 1.0)
CONFIDENCE_THRESHOLD=0.5

# Retrieval: number of top chunks to retrieve per query
TOP_K=5
